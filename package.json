{
  "name": "dhaka-tesla-pool-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Dhaka Tesla Pool - Share a seat. Split the fare. Survive Dhaka traffic.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"cyan,emerald\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "test:api": "npm run test --workspace=apps/api"
  },
  "keywords": [
    "dhaka",
    "tesla",
    "ride-pooling",
    "nextjs",
    "express",
    "postgresql",
    "leaflet"
  ],
  "author": "Md Mehedi Hasan Shishir",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
