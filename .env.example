# ==============================================================================
# Dhaka Tesla Pool - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# Option A: Local Docker PostgreSQL (default)
DATABASE_URL="postgresql://teslapool:teslapool123@localhost:5433/dhaka_tesla_pool?schema=public"

# Option B: Neon PostgreSQL on Vercel (copy from https://console.neon.tech)
# DATABASE_URL="postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# (Optional) Direct URL for Neon pooled connections:
# DIRECT_URL="postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local Docker Postgres credentials
DB_USER=teslapool
DB_PASSWORD=teslapool123
DB_NAME=dhaka_tesla_pool
DB_PORT=5433

# ------------------------------------------------------------------------------
# 2. API & Authentication (Express / Vercel Serverless)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
JWT_SECRET=dhaka-tesla-pool-super-secret-key-change-in-production
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Frontend Next.js Configuration
# ------------------------------------------------------------------------------
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:4000

# On Vercel:
# - Leave NEXT_PUBLIC_API_URL unset to automatically use same-domain `/api` serverless routes
# - Or set BACKEND_URL to proxy `/api/*` to an external backend:
# BACKEND_URL=https://api.yourdomain.com
