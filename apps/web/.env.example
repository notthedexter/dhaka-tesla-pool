# ==============================================================================
# Dhaka Tesla Pool - Web Frontend Environment Configuration
# ==============================================================================

# Local development backend API URL:
NEXT_PUBLIC_API_URL=http://localhost:4000

# On Vercel:
# - Leave NEXT_PUBLIC_API_URL empty/unset to use same-origin relative `/api/*` serverless calls
# - Or specify BACKEND_URL to proxy `/api/*` to an external backend:
# BACKEND_URL=https://api.yourdomain.com
